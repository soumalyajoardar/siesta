# Copy to ".env" (same folder as package.json) and fill in your values.
# The server reads these at startup. Never commit real keys to git.
#   Windows PowerShell:  Copy-Item .env.example .env
#   then edit .env, then: npm start

# --- Supabase (database + image storage). Leave BOTH empty to keep the
# --- built-in local JSON files. Set BOTH to switch to Supabase.
# Find them at: https://supabase.com/dashboard → your project → Settings → API
#   SUPABASE_URL = Project URL  (https://xyzcompany.supabase.co)
#   SUPABASE_SERVICE_KEY = service_role key (server-only! never the anon key
#   for this variable — the service key bypasses row security on the server)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Optional: admin dashboard password — used ONCE to create the login stored
# (scrypt-hashed) in the database, then ignored. Afterwards the DB record
# rules; rotate it in Admin → Settings. Omit to get a generated password
# printed on first local boot. (On Vercel, set it once before first deploy
# if the database has no admin login yet.)
# ADMIN_PASSWORD=

# Optional: server port (default: 3000) and host (default: 0.0.0.0 = LAN visible)
# PORT=3000
